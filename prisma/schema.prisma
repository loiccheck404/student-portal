// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("student")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  student   Student?
}

model Student {
  id              String   @id @default(cuid())
  userId          String   @unique
  matricNumber    String   @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  phone           String?
  address         String?
  facultyId       String
  faculty         Faculty  @relation(fields: [facultyId], references: [id])
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  level           String   // "100", "200", "300", "400", "500"
  enrollmentYear  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrations   CourseRegistration[]
  grades          Grade[]
  notifications   Notification[]
   studentFees          StudentFee[]
  payments             Payment[]
  hostelApplication    HostelApplication?
}

// NEW: Faculty table
model Faculty {
  id          String       @id @default(cuid())
  name        String       @unique  // "Faculty of Science", "Faculty of Arts"
  code        String       @unique  // "FS", "FA", "FEMS"
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  departments Department[]
  students    Student[]
  courses     Course[]
}

// NEW: Department table
model Department {
  id          String    @id @default(cuid())
  name        String    // "Computer Engineering", "Biochemistry"
  code        String    // "CEN", "BCH"
  facultyId   String
  faculty     Faculty   @relation(fields: [facultyId], references: [id])
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  students    Student[]
  courses     Course[]
  
  @@unique([facultyId, code]) // Department code must be unique within faculty
}

// UPDATED: Course table with Faculty, Department, and Level
model Course {
  id               String                @id @default(cuid())
  courseCode       String                @unique
  courseName       String
  credits          Int
  courseType       String                // "Major", "Minor", "Elective"
  facultyId        String
  faculty          Faculty               @relation(fields: [facultyId], references: [id])
  departmentId     String
  department       Department            @relation(fields: [departmentId], references: [id])
  level            String                // "100", "200", "300", "400", "500"
  availableSpots   Int
  totalSpots       Int
  semester         String                // "Fall 2024", "Spring 2025"
  description      String?
  registrations    CourseRegistration[]
  grades           Grade[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model CourseRegistration {
  id               String    @id @default(cuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  registeredAt     DateTime  @default(now())

  @@unique([studentId, courseId]) // Prevents double registration
}

// Grade model for storing student results
model Grade {
  id               String    @id @default(cuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score            Float     // Numerical score (0-100)
  letterGrade      String    // "A", "B+", "C", etc.
  gradePoint       Float     // GPA value (4.0, 3.5, etc.)
  semester         String    // "Fall 2024", "Spring 2025"
  academicYear     String    // "2024/2025"
  remarks          String?   // "Excellent", "Pass", "Fail", etc.
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([studentId, courseId, semester]) // One grade per course per semester
  @@index([studentId])
  @@index([courseId])
}

model Notification {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   // "grade", "payment", "course", "announcement"
  isRead      Boolean  @default(false)
  link        String?  // Optional link to related page
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([isRead])
}

// Fee Management
model FeeType {
  id          String   @id @default(cuid())
  name        String   // e.g., "Tuition", "Registration", "Library"
  amount      Float    // Total amount for this fee
  description String?
  semester    String   // e.g., "Fall 2024", "Spring 2025"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentFees StudentFee[]
}

model StudentFee {
  id          String   @id @default(cuid())
  studentId   String
  feeTypeId   String
  totalAmount Float    // Total fee amount
  paidAmount  Float    @default(0) // How much student has paid
  balance     Float    // Remaining balance
  status      String   @default("Unpaid") // "Unpaid", "Partial", "Paid"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeType  FeeType   @relation(fields: [feeTypeId], references: [id])
  payments Payment[]

  @@unique([studentId, feeTypeId])
}

model Payment {
  id              String   @id @default(cuid())
  studentId       String
  studentFeeId    String?  // For fee payments
  hostelAppId     String?  // For hostel payments
  amount          Float
  paymentMethod   String   // "MTN", "Orange", "Express"
  transactionId   String   @unique
  status          String   @default("Completed") // "Completed", "Failed", "Pending"
  createdAt       DateTime @default(now())

  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentFee   StudentFee?      @relation(fields: [studentFeeId], references: [id])
  hostelApp    HostelApplication? @relation(fields: [hostelAppId], references: [id])
}

// Hostel Management
model Dorm {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Block A", "Block B"
  description String?
  totalRooms  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]
}

model Room {
  id              String   @id @default(cuid())
  dormId          String
  roomNumber      String   // e.g., "101", "102"
  isOccupied      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dorm              Dorm                @relation(fields: [dormId], references: [id], onDelete: Cascade)
  hostelApplications HostelApplication[]

  @@unique([dormId, roomNumber])
}

model HostelApplication {
  id          String   @id @default(cuid())
  studentId   String   @unique // One application per student
  dormId      String?  // Assigned by admin
  roomId      String?  @unique // Selected by student
  feeAmount   Float    @default(50000) // Fixed hostel fee (50,000 FCFA)
  paidAmount  Float    @default(0)
  status      String   @default("Pending") // "Pending", "Paid"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dorm     Dorm?     @relation(fields: [dormId], references: [id])
  room     Room?     @relation(fields: [roomId], references: [id])
  payments Payment[]
}