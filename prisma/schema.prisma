// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("student")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  student   Student?
}

model Student {
  id              String   @id @default(cuid())
  userId          String   @unique
  matricNumber    String   @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  phone           String?
  address         String?
  facultyId       String
  faculty         Faculty  @relation(fields: [facultyId], references: [id])
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  level           String   // "100", "200", "300", "400", "500"
  enrollmentYear  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrations   CourseRegistration[]
  grades          Grade[]
}

// NEW: Faculty table
model Faculty {
  id          String       @id @default(cuid())
  name        String       @unique  // "Faculty of Science", "Faculty of Arts"
  code        String       @unique  // "FS", "FA", "FEMS"
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  departments Department[]
  students    Student[]
  courses     Course[]
}

// NEW: Department table
model Department {
  id          String    @id @default(cuid())
  name        String    // "Computer Engineering", "Biochemistry"
  code        String    // "CEN", "BCH"
  facultyId   String
  faculty     Faculty   @relation(fields: [facultyId], references: [id])
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  students    Student[]
  courses     Course[]
  
  @@unique([facultyId, code]) // Department code must be unique within faculty
}

// UPDATED: Course table with Faculty, Department, and Level
model Course {
  id               String                @id @default(cuid())
  courseCode       String                @unique
  courseName       String
  credits          Int
  courseType       String                // "Major", "Minor", "Elective"
  facultyId        String
  faculty          Faculty               @relation(fields: [facultyId], references: [id])
  departmentId     String
  department       Department            @relation(fields: [departmentId], references: [id])
  level            String                // "100", "200", "300", "400", "500"
  availableSpots   Int
  totalSpots       Int
  semester         String                // "Fall 2024", "Spring 2025"
  description      String?
  registrations    CourseRegistration[]
  grades           Grade[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model CourseRegistration {
  id               String    @id @default(cuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  registeredAt     DateTime  @default(now())

  @@unique([studentId, courseId]) // Prevents double registration
}

// Grade model for storing student results
model Grade {
  id               String    @id @default(cuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score            Float     // Numerical score (0-100)
  letterGrade      String    // "A", "B+", "C", etc.
  gradePoint       Float     // GPA value (4.0, 3.5, etc.)
  semester         String    // "Fall 2024", "Spring 2025"
  academicYear     String    // "2024/2025"
  remarks          String?   // "Excellent", "Pass", "Fail", etc.
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([studentId, courseId, semester]) // One grade per course per semester
  @@index([studentId])
  @@index([courseId])
}